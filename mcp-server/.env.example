# Copy this file to .env and adjust if needed. Never commit .env.
# All values below have working defaults - this file is optional to create
# at all unless you want to change host/port.

# --- Server ---
MCP_SERVER_NAME=Personal AI Tools
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_STREAMABLE_HTTP_PATH=/mcp
LOG_LEVEL=INFO

# --- Weather (Open-Meteo) ---
# No API key required - Open-Meteo's forecast and geocoding APIs are free
# for non-commercial use with no signup/key at all. See README.md's
# "Weather API" section for why this provider was chosen and what the
# free-tier limits actually are.
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_SECONDS=10
WEATHER_MAX_FORECAST_DAYS=16

# --- Email (Gmail API) ---
# Optional - leave all four blank and the server starts fine, it just won't
# register send_email/list_recent_emails/read_email at all. To enable email:
# 1. Google Cloud Console -> enable the "Gmail API" for a project.
# 2. Create an OAuth 2.0 Client ID, application type "Desktop app".
# 3. Run: uv run python scripts/gmail_authorize.py
#    (paste the Client ID/Secret from step 2 when prompted; it opens your
#    browser for a one-time Google sign-in + consent)
# 4. Copy the GMAIL_* lines it prints into this file.
# See README.md's "Email (Gmail)" section for the full walkthrough.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
EMAIL_REQUEST_TIMEOUT_SECONDS=10
EMAIL_LIST_MAX_RESULTS=25
EMAIL_BODY_MAX_CHARS=4000
