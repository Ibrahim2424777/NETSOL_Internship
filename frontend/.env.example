# Copy this file to .env and adjust for your environment.
# Note: everything prefixed VITE_ is bundled into the client-side JS and is
# publicly visible - never put a real secret in here. The Google Client ID
# is meant to be public (it identifies the app to Google, it doesn't
# authenticate anything by itself), unlike GOOGLE_CLIENT_SECRET which only
# ever lives in the backend's .env.

# Backend API base URL, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Same OAuth client as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Must exactly match the backend's GOOGLE_REDIRECT_URI and an "Authorized
# redirect URI" registered on the OAuth client in Google Cloud Console.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
