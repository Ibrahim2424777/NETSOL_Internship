# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_NAME=AI Chatbot Backend
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL (source of truth) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_chatbot
# Optional - defaults shown are SQLAlchemy's own defaults, just made
# explicit/tunable. Raise if you see connection-pool-exhaustion errors
# under real concurrent load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis (cache layer only) ---
REDIS_URL=redis://localhost:6379/0

# --- LangGraph conversational memory ---
# Optional - most recent N messages (both roles) sent to Gemini as context.
MAX_HISTORY_MESSAGES=20

# --- LangGraph routing ---
# Optional - most recent N messages the router's classification call sees.
ROUTER_CONTEXT_MESSAGES=6

# --- Document RAG ---
# Optional - all have working defaults. RAG_VECTOR_DB_PATH is a local
# directory (LanceDB, embedded/persistent - not Postgres or Redis).
RAG_VECTOR_DB_PATH=./data/vector_store
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=4
RAG_MIN_SCORE=0.6
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# --- Gemini ---
# Required - the app fails to start without this. From Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (fallback LLM provider) ---
# Optional - get a free key at https://console.groq.com/keys. Without it,
# the app runs Gemini-only (no fallback available, same as before this
# provider existed).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# "gemini" (default, real behavior) or "groq" (dev-only override - talk to
# Groq directly, skipping Gemini and the fallback wrapper entirely).
LLM_PROVIDER=gemini
# "groq" (default) or "none" to disable automatic fallback.
LLM_FALLBACK_PROVIDER=groq

# --- Web search (Phase 18) ---
# Tavily is the retrieval layer for the web_search route - get a free key at
# https://tavily.com. Optional: without it, web_search still works, it just
# answers from the model's own knowledge with an explicit "I don't have
# live search results" disclaimer instead of grounding in real results (see
# app/langgraph/nodes/web_search_node.py). Generation still goes through the
# same Gemini-primary/Groq-fallback ModelService as everything else above -
# there's no separate provider pairing for this route anymore.
TAVILY_API_KEY=
# Deliberately small - do not retrieve dozens of pages per query.
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15

# --- MCP (Phase 17) ---
# The standalone MCP server (../mcp-server) - a separate process, started
# separately (uv run python server.py from mcp-server/). Not required for
# this app to start; if it's unreachable, normal chat still works, just
# without weather/email tools that turn (see agent_node.py).
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
MCP_REQUEST_TIMEOUT_SECONDS=15

# --- Google OAuth 2.0 ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" registered on that client.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# --- JWT ---
# Required - the app fails to start without these. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use two DIFFERENT values so a leaked access-token secret can't be used to
# forge refresh tokens, or vice versa.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
